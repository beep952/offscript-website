<!doctype html>
<html lang="en"><head><meta charset="utf-8">
<title>OG card source, 1200x630</title>
<link rel="stylesheet" href="https://fonts.googleapis.com/css2?family=Inter:wght@400;500&family=Playfair+Display:wght@600&display=swap">
<style>
html,body{margin:0;background:#141413}
.card{width:1200px;height:630px;box-sizing:border-box;padding:72px 80px;background:#141413;color:#FCFBF9;display:flex;flex-direction:column;justify-content:space-between;font-family:Inter,system-ui,sans-serif}
.card img{width:300px;height:75px;display:block}
h1{font:600 70px/1.1 "Playfair Display",Georgia,serif;letter-spacing:-.01em;margin:0;max-width:900px}
p{font:400 28px/1.45 Inter,sans-serif;color:#B9B4A8;margin:22px 0 0;max-width:820px}
.foot{display:flex;justify-content:space-between;align-items:center;border-top:1px solid #3A3935;padding-top:24px;font-size:24px;color:#BC8F55}
.foot span:first-child{color:#D8D2C6}
</style></head><body>
<div class="card">
  <!-- Approved reversed horizontal lockup from the brand kit (Drive: offscript-logo-horizontal-reversed.png) -->
  <img src="assets/offscript-logo-horizontal-reversed.png" alt="Offscript Editorial">
  <div>
    <h1>You already said it. We put it in writing.</h1>
    <p>Leadership writing from the talks you have already given. No interviews. No meetings.</p>
  </div>
  <div class="foot"><span>Written off script. Right on message.</span><span>offscripteditorial.com</span></div>
</div>
</body></html>
